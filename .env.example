# Copy to .env (never commit it) or to /etc/vigi-nvr-mcp.env (mode 0600).
# Every value below is a placeholder.

# --- NVR connection -------------------------------------------------------
VIGI_NVR_HOST=<nvr-host>
VIGI_NVR_PORT=443
VIGI_NVR_USERNAME=admin
VIGI_NVR_PASSWORD=<your-nvr-password>
# VIGI NVRs ship self-signed certificates, so verification is off by default.
VIGI_NVR_VERIFY_TLS=false
# Request timeout in seconds.
VIGI_NVR_TIMEOUT_SECONDS=10

# --- Safety switches ------------------------------------------------------
# Allow non-"get" methods through nvr_call (each call still needs confirm_write=true).
VIGI_NVR_ALLOW_WRITES=false
# Freeze authentication entirely: no login attempt will be made while true.
VIGI_NVR_LOGIN_DISABLED=false
# Failed logins tolerated per process before all further logins are refused (1-5).
VIGI_NVR_MAX_LOGIN_FAILURES=1

# --- MCP server -----------------------------------------------------------
# stdio | streamable-http
VIGI_MCP_TRANSPORT=stdio
VIGI_MCP_HOST=127.0.0.1
VIGI_MCP_PORT=8765
