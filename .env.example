# Copy to .env (never commit it) or to /etc/tplink-local-mcp.env (mode 0600).
# Every value below is a placeholder. 192.0.2.x addresses are RFC 5737
# documentation examples; replace them with your devices' addresses.
#
# A device backend is enabled only when its <PREFIX>HOST is set.

# --- MCP server -----------------------------------------------------------
# stdio | streamable-http
TPLINK_MCP_TRANSPORT=stdio
TPLINK_MCP_HOST=127.0.0.1
TPLINK_MCP_PORT=8765
# TPLINK_MCP_LOG_LEVEL=INFO

# --- VIGI NVR (tools: nvr_*) ----------------------------------------------
TPLINK_NVR_HOST=192.0.2.10
TPLINK_NVR_PORT=443
TPLINK_NVR_USERNAME=admin
TPLINK_NVR_PASSWORD=<your-nvr-password>
# VIGI NVRs ship self-signed certificates, so verification is off by default.
TPLINK_NVR_VERIFY_TLS=false
TPLINK_NVR_TIMEOUT_SECONDS=10
# Writes need this AND confirm_write=true on each call.
TPLINK_NVR_ALLOW_WRITES=false
# Return the exact write request without sending it.
TPLINK_NVR_DRY_RUN=false
# Freeze authentication entirely: no login attempt is made while true.
TPLINK_NVR_LOGIN_DISABLED=false
# Failed logins tolerated per process before all logins are refused (1-5).
TPLINK_NVR_MAX_LOGIN_FAILURES=1
# Where nvr_backup_config writes files (mode 0600). Backups can hold credentials.
TPLINK_NVR_BACKUP_DIR=backups

# --- Archer router (tools: router_*; pending protocol discovery) ------------
# TPLINK_ROUTER_HOST=192.0.2.1
# TPLINK_ROUTER_USERNAME=admin
# TPLINK_ROUTER_PASSWORD=<your-router-password>
# TPLINK_ROUTER_ALLOW_WRITES=false
# TPLINK_ROUTER_LOGIN_DISABLED=false

# --- Easy Smart switch (tools: switch_*; pending protocol discovery) --------
# TPLINK_SWITCH_HOST=192.0.2.2
# TPLINK_SWITCH_USERNAME=admin
# TPLINK_SWITCH_PASSWORD=<your-switch-password>
# TPLINK_SWITCH_ALLOW_WRITES=false
# TPLINK_SWITCH_LOGIN_DISABLED=false
