# Copy to .env (never commit it) or to /etc/vigi-nvr-mcp.env (mode 0600).
# Every value is a placeholder; 192.0.2.x is an RFC 5737 documentation address.

# --- NVR connection -------------------------------------------------------
VIGI_NVR_HOST=192.0.2.10
VIGI_NVR_PORT=443
VIGI_NVR_USERNAME=admin
VIGI_NVR_PASSWORD=<your-nvr-password>
# VIGI NVRs ship self-signed certificates, so verification is off by default.
VIGI_NVR_VERIFY_TLS=false
# Pin the NVR's certificate by its SHA-256 fingerprint (64 hex, colons optional).
# When set, the transport fails closed if the peer cert does not match. Get the
# observed value from nvr_status / --check-auth (tls_fingerprint_observed).
# VIGI_NVR_TLS_FINGERPRINT_SHA256=
VIGI_NVR_TIMEOUT_SECONDS=10

# --- Safety switches ------------------------------------------------------
# Writes need this AND confirm_write=true on each call.
VIGI_NVR_ALLOW_WRITES=false
# Return the exact write request without sending it.
VIGI_NVR_DRY_RUN=false
# Freeze authentication entirely: no login attempt is made while true.
VIGI_NVR_LOGIN_DISABLED=false
# Failed logins tolerated per process before all logins are refused (1-5).
VIGI_NVR_MAX_LOGIN_FAILURES=1
# Where nvr_backup_config writes files (mode 0600). Backups can hold credentials.
VIGI_NVR_BACKUP_DIR=backups
# Where the persistent login breaker stores its per-host state (mode 0600).
# Default: ~/.local/state/vigi-nvr-mcp/
# VIGI_NVR_STATE_DIR=

# --- MCP server -----------------------------------------------------------
# stdio | streamable-http
VIGI_MCP_TRANSPORT=stdio
VIGI_MCP_HOST=127.0.0.1
VIGI_MCP_PORT=8765
# VIGI_MCP_LOG_LEVEL=INFO
